#  Find Missing Number in a sorted array_Solution

def binary_search(nums, target):
    l = 0
    r = len(nums) - 1
    while l <= r:
        mid = (l + r) // 2
        if nums[mid] == target:
            return mid 
        elif nums[mid] > target:
            r = mid - 1
        else:
            l = mid + 1
    return l

#example
arr = [1, 3, 5, 7, 9]
target = 5
result = binary_search(arr, target)
print(f"Target {target} index {result}")
arr = [1, 3, 5, 7, 9]
target = 2
result = binary_search(arr, target)
